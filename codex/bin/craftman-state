#!/usr/bin/env bash
# AI-Craftman run state. Plain text on purpose: readable by humans, greppable by hooks.
# Files: .craftman/active-run, .craftman/memory/index.md, .craftman/memory/<run>/{state,approvals,answers,escalations}.md,
# .craftman/hidden/<run>/ (the acceptance suite the builders never see: command, suite.tgz)
set -euo pipefail

ROOT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
MEM="$ROOT/.craftman/memory"
ACTIVE="$ROOT/.craftman/active-run"
HID="$ROOT/.craftman/hidden"

STAGES="requirements context architecture engineering qa devops"
# step:stage:owner
FULL_STEPS="triage:requirements:triage
requirements:requirements:requirements-planner
clarifications:requirements:human-liaison
gov-requirements:requirements:governance
context:context:enterprise-context
legacy-analysis:context:legacy-analyst
context-memory:context:memory-keeper
architecture:architecture:architect
gov-architecture:architecture:governance
approve-architecture:architecture:human-oversight
design:architecture:architect
gov-design:architecture:governance
work-plan:architecture:workflow-coordinator
hidden-tests:architecture:acceptance-writer
tracker-issues:architecture:orchestrator
git-branch:engineering:orchestrator
engineering:engineering:tdd-engineer,test-writer,code-writer,code-reviewer,code-optimizer
security-review:engineering:security-reviewer
e2e:qa:e2e-verifier
qa:qa:qa-engineer
docs:qa:doc-writer
gov-release:qa:governance
pull-request:qa:orchestrator
delivery:devops:delivery-manager
deploy-decisions:devops:human-liaison
approve-deploy:devops:human-oversight
devops:devops:devops-engineer
operations:devops:operations-engineer
summary:finish:memory-keeper"
LITE_SKIP="gov-requirements approve-architecture design gov-design work-plan tracker-issues security-review"
# a bugfix is lite without a design: the requirement, the context and the hidden repro test are the spec
BUGFIX_SKIP="$LITE_SKIP architecture gov-architecture"
# Gates are marked done only with their evidence on disk. step:result-file-prefix:passing-verdict
GATES="gov-requirements:03-gov-requirements:PASS
gov-architecture:07-gov-architecture:PASS
gov-design:08b-gov-design:PASS
hidden-tests:09a-hidden-tests:RED_CONFIRMED
security-review:10-security:PASS
e2e:11a-e2e:PASS
qa:11-qa:READY
gov-release:13-gov-release:PASS"
PROTECTED="gov-requirements gov-architecture approve-architecture gov-design hidden-tests security-review e2e qa gov-release"

die() { echo "craftman-state: $*" >&2; exit 1; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
epoch() { date -u +%s; }
dur() { local s=$1; [ "$s" -ge 3600 ] && printf '%dh%02dm' $((s/3600)) $((s%3600/60)) || printf '%dm%02ds' $((s/60)) $((s%60)); }
# elapsed since the previous done/skip (or init); steps run in order, so this is the step's wall-clock time
elapsed() { local last; last=$(get last_mark "$1"); [ -n "$last" ] && dur $(( $(epoch) - last )) || echo "?"; }
run_id() { [ -n "${1:-}" ] && echo "$1" || { [ -f "$ACTIVE" ] && cat "$ACTIVE"; } || die "no active run; pass a run id"; }
state_file() { local f="$MEM/$(run_id "${1:-}")/state.md"; [ -f "$f" ] || die "no state at $f"; echo "$f"; }
get() { sed -n "s/^$1: //p" "$2" | head -1; }
# replace "key: ..." line in place (portable: no sed -i; temp file beside target works inside the sandbox)
# Values and notes reach awk through the environment, never -v (which would interpret backslash escapes), and
# without line breaks, so text typed by the model cannot add lines to state.md.
oneline() { printf '%s' "$1" | tr '\n\r' '  '; }
put() { local tmp; tmp=$(mktemp "$3.XXXXXX"); CS_VAL=$(oneline "$2") awk -v k="$1" 'BEGIN{d=0; v=ENVIRON["CS_VAL"]} index($0,k": ")==1 && !d {print k": "v; d=1; next} {print}' "$3" > "$tmp" && mv "$tmp" "$3"; }
# A step is named exactly: a pattern such as "x|.*gov-release" would match a gate's line and skip its check.
known_step() { echo "$FULL_STEPS" | cut -d: -f1 | grep -qxF -- "$1" || die "unknown step: $1"; }
stage_index() { local i=0 s; for s in $STAGES; do [ "$s" = "$1" ] && { echo $i; return; }; i=$((i+1)); done; [ "$1" = finish ] && { echo 99; return; }; die "unknown stage: $1 (use: $STAGES)"; }
mark() { # mark <state> <step> <char> <note>
  local tmp; tmp=$(mktemp "$1.XXXXXX")
  # a step line is "- [c] step" then the end of the line or a space; compared as text, not as a pattern
  CS_NOTE=$(oneline "$4") awk -v s="$2" -v c="$3" 'BEGIN{n=ENVIRON["CS_NOTE"]}
    substr($0,1,3)=="- [" && substr($0,5,2)=="] " && (substr($0,7)==s || index(substr($0,7), s" ")==1) {print "- ["c"] "s"  "n; f=1; next}
    {print} END{exit !f}' "$1" > "$tmp" || { rm -f "$tmp"; die "unknown step: $2"; }
  mv "$tmp" "$1"
}

# One writer at a time for state.md (the hooks update it too). The lock is a file the shell creates with O_EXCL
# (noclobber), never a directory from mkdir(1), which uutils coreutils handed to two processes at once (see
# agent-budget.sh). A lock older than 5s belongs to a crashed holder and is taken over; a busy one is waited for
# (up to 60s), so a queue of parallel hooks never loses a write.
LOCK="$ROOT/.craftman/.lock"
lock_age() { echo $(( $(date +%s) - $(date -r "$LOCK" +%s 2>/dev/null || date +%s) )); }   # date -r: file mtime, BSD and GNU
lock() {
  [ -d "$ROOT/.craftman" ] || return 0; local i=0
  [ ! -d "$LOCK" ] || rmdir "$LOCK" 2>/dev/null || true   # a directory lock left by a version before 0.8.0
  until ( set -C; : > "$LOCK" ) 2>/dev/null; do
    [ "$(lock_age)" -lt 5 ] || { rm -f "$LOCK"; continue; }
    i=$((i+1)); [ "$i" -ge 600 ] && break; sleep 0.1
  done
  trap 'rm -f "$LOCK"' EXIT
}
# docker with a time limit: a sick daemon can hang for minutes, and a state change must never wait on it
dock() {
  command -v docker >/dev/null 2>&1 || return 1
  docker "$@" 2>/dev/null & local p=$!
  ( sleep 8; kill "$p" 2>/dev/null ) >/dev/null 2>&1 & local w=$! rc=0
  wait "$p" 2>/dev/null || rc=$?
  kill "$w" 2>/dev/null || true
  return "$rc"
}
# limit <secs> <command>: run a shell command with a time limit and kill its whole process group on timeout (exit 124).
# macOS has no timeout(1), and a hung suite must end as a FAIL, never as a run that waits for hours.
limit() {
  python3 - "$1" "$2" <<'EOF'
import os, signal, subprocess, sys
secs, cmd = float(sys.argv[1]), sys.argv[2]
p = subprocess.Popen(cmd, shell=True, start_new_session=True)
try:
    sys.exit(p.wait(timeout=secs))
except subprocess.TimeoutExpired:
    os.killpg(p.pid, signal.SIGKILL)
    p.wait()
    sys.exit(124)
EOF
}
# Containers, and processes that reference the project path (test runs, dev servers), as "kind id details" lines
running() {
  local pids
  dock ps --format 'container {{.ID}} {{.Image}} {{.Names}}' || echo "docker down"
  pids=$(pgrep -f "$ROOT/" 2>/dev/null | grep -vx "$$" | paste -sd, - || true)
  [ -z "$pids" ] || ps -o pid=,command= -p "$pids" 2>/dev/null | sed 's/^ */process /' || true
}
design_ok() { # design_ok <dir> <file-prefix> <diagrams>: the design has its mermaid diagrams and they will render
  grep -qs '^[[:space:]]*```mermaid' "$1/$2"*.md || die "$2.md needs its mermaid diagrams ($3): the human reads the design as diagrams"
  command -v python3 >/dev/null 2>&1 || return 0
  local problems; problems=$(python3 "$REPORT" --lint "$1/$2"*.md 2>/dev/null) \
    || die "$2.md has diagrams that will not render; have the architect fix them in place:"$'\n'"$problems"
}
latest() { # newest result of a gate: <prefix>.md is round 1, <prefix>-<n>.md is round n. Nothing else is a result:
  # the guards protect exactly these names, so a look-alike (11a-e2ex.md, hidden-2x.md) must not be read here
  local f n best="" top=0 base; base=$(basename "$1")
  for f in "$1".md "$1"-[0-9]*.md; do
    [ -f "$f" ] || continue
    n=$(basename "$f" .md); n=${n#"$base"}
    case "$n" in '') n=1;; -*) n=${n#-}; case "$n" in *[!0-9]*) continue;; esac;; *) continue;; esac
    [ "$n" -ge "$top" ] && { best=$f; top=$n; }
  done
  echo "$best"
}
granted() { grep -Eq "^granted: $1( |\$)" "$(dirname "$2")/approvals.md" 2>/dev/null; }   # granted <category> <state-file>
verified() { # engineering is done when craftman-state itself saw the suites pass: the newest verify/tests and verify/hidden
  local dir v; dir=$(dirname "$1")
  granted waiver-engineering "$1" && return 0
  if grep -Eqs '^test_command: *[^ ]' "$(latest "$dir/04-context")"; then
    v=$(latest "$dir/verify/tests"); grep -qs '^verdict: PASS' "$v" || die "engineering needs a passing 'craftman-state verify tests' (newest result: ${v:-none})"
  fi
  if grep -Eq '^- \[x\] hidden-tests( |$)' "$1"; then
    v=$(latest "$dir/verify/hidden"); grep -qs '^verdict: PASS' "$v" || die "engineering needs a passing 'craftman-state verify hidden' (newest result: ${v:-none})"
  fi
}
check_gate() { # check_gate <state-file> <step>: refuse unless the step's evidence exists
  local dir g prefix want; dir=$(dirname "$1")
  case "$2" in
    approve-architecture)
      granted architecture "$1" || grep -qs '^verdict: NO_APPROVAL_NEEDED' "$(latest "$dir/08-oversight-architecture")" \
        || die "approve-architecture needs the human's [APPROVAL:architecture] answer (or an oversight verdict NO_APPROVAL_NEEDED)";;
    approve-deploy) granted deploy "$1" || die "approve-deploy needs the human's [APPROVAL:deploy] answer";;
    # the human reads the design as diagrams (report, Design tab), so a design without them is not done
    architecture) design_ok "$dir" 06-hld "block diagram, main flow";;
    design) design_ok "$dir" 08a-lld "modules, data model, main flows";;
    # the suite is packed away before any builder starts; a library has nothing to drive end to end; code is done when
    # craftman-state ran the suites itself
    *) [ "$2" != hidden-tests ] || [ -f "$HID/$(get run "$1")/suite.tgz" ] || die "hidden-tests needs the suite packed first: craftman-state hide"
       [ "$2" != e2e ] || ! grep -Eqs '^e2e_mode: *none' "$(latest "$dir/00-triage")" || return 0
       [ "$2" != engineering ] || verified "$1"
       g=$(echo "$GATES" | grep "^$2:") || return 0
       prefix=$(echo "$g" | cut -d: -f2); want=$(echo "$g" | cut -d: -f3)
       # the newest result decides (a later BLOCK overrides an earlier PASS); a waiver is for this gate only
       g=$(latest "$dir/$prefix"); [ -n "$g" ] || die "$2 has no result file ($prefix*.md); run the gate first"
       grep -qs "^verdict: $want" "$g" || granted "waiver-$2" "$1" \
         || die "$2 needs 'verdict: $want' in $(basename "$g"), or the human's waiver for this gate ([APPROVAL:waiver-$2])";;
  esac
}

cmd_init() {
  local run="${1:-}"; shift || true
  case "$run" in ''|.*|*[!A-Za-z0-9._-]*) die "run id may only contain letters, digits, dot, underscore and hyphen, and not start with a dot: '$run'";; esac
  [ -n "$run" ] || die "usage: init <run-id> [--profile full|lite|bugfix] [--from STAGE] [--to STAGE] [--skip-deploy] [--lead] [--max-agent-calls N] [--requirement TEXT]"
  local profile=full setby=default from=requirements to=devops skipdeploy=0 lead=off max=60 req=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) profile="$2"; setby=flag; shift 2;;
      --from) from="$2"; shift 2;;
      --to) to="$2"; shift 2;;
      --skip-deploy) skipdeploy=1; shift;;
      --lead) lead=on; shift;;
      --max-agent-calls) max="$2"; shift 2;;
      --requirement) req="$2"; shift 2;;
      *) die "unknown option $1";;
    esac
  done
  local skipset=""
  case "$profile" in full) ;; lite) skipset=$LITE_SKIP;; bugfix) skipset=$BUGFIX_SKIP;; *) die "profile must be full, lite or bugfix";; esac
  req=$(oneline "$req")
  case "$max" in ''|*[!0-9]*) max=60;; esac   # unsubstituted ${user_config...} falls back here
  local fi ti; fi=$(stage_index "$from"); ti=$(stage_index "$to")
  [ "$fi" -le "$ti" ] || die "--from is after --to"
  local dir="$MEM/$run"
  [ -f "$dir/state.md" ] && die "run $run already exists; use resume"
  mkdir -p "$dir"
  {
    echo "run: $run"
    echo "requirement: $req"
    echo "profile: $profile"
    echo "profile_set_by: $setby"
    echo "lead: $lead"
    echo "status: in_progress"
    echo "started: $(now)"
    echo "finished: "
    echo "duration: "
    echo "last_mark: $(epoch)"
    echo "agent_calls: 0"
    echo "max_agent_calls: $max"
    echo "branch: "
    echo "packages_done: "
    echo
    echo "## steps"
    local line step stage si
    while IFS= read -r line; do
      step=${line%%:*}; stage=$(echo "$line" | cut -d: -f2); si=$(stage_index "$stage")
      if [ "$si" -lt "$fi" ]; then echo "- [-] $step  (skipped: before --from $from)"
      elif [ "$si" -gt "$ti" ] && [ "$stage" != finish ]; then echo "- [-] $step  (skipped: after --to $to)"
      elif [ "$stage" = devops ] && [ "$skipdeploy" = 1 ]; then echo "- [-] $step  (skipped: --skip-deploy)"
      elif [ -n "$skipset" ] && echo " $skipset " | grep -q " $step "; then echo "- [-] $step  (skipped: $profile profile)"
      else echo "- [ ] $step"; fi
    done <<< "$FULL_STEPS"
  } > "$dir/state.md"
  for f in approvals answers escalations; do [ -f "$dir/$f.md" ] || echo "# $f ($run)" > "$dir/$f.md"; done
  mkdir -p "$MEM"; [ -f "$MEM/index.md" ] || echo "# AI-Craftman runs" > "$MEM/index.md"
  echo "- $run | in_progress | $(now) | ${req:0:100}" >> "$MEM/index.md"
  echo "$run" > "$ACTIVE"
  # A committed active-run would switch the guards on for everyone who pulls the branch. The hidden suite stays out of
  # the builders' diffs and commits until QA reveals it.
  local p; for p in active-run .lock .agents-active .plugin-root hidden/ 'memory/*/report.html' 'memory/*/report-version.js'; do grep -qxF "$p" "$ROOT/.craftman/.gitignore" 2>/dev/null || echo "$p" >> "$ROOT/.craftman/.gitignore"; done
  # What is already running, so the run can stop exactly what it started and nothing else.
  running 2>/dev/null | cut -d' ' -f1,2 > "$dir/services-before.txt" || true
  refresh "$dir/state.md"
  echo "initialized $run ($profile, $from..$to$([ $skipdeploy = 1 ] && echo ', skip-deploy'))"
  cmd_next "$run"
}

cmd_next() {
  local f; f=$(state_file "${1:-}")
  local step; step=$(sed -n 's/^- \[ \] \([a-z-]*\).*/\1/p' "$f" | head -1)
  if [ -z "$step" ]; then echo "next: none (all steps done or skipped)"; return; fi
  local line; line=$(echo "$FULL_STEPS" | grep "^$step:")
  echo "next: $step  stage: $(echo "$line" | cut -d: -f2)  owner: $(echo "$line" | cut -d: -f3)"
}

cmd_done() { local f; f=$(state_file); known_step "${1:?step}"; check_gate "$f" "$1"; mark "$f" "$1" x "(done $(now), took $(elapsed "$f")) ${2:-}"; put last_mark "$(epoch)" "$f"; refresh "$f"; cmd_next; }
cmd_skip() {
  local f; f=$(state_file); known_step "${1:?step}"
  case " $PROTECTED " in *" ${1:?step} "*) granted "waiver-$1" "$f" || die "$1 is a gate: only the profile, --from/--to or the human's waiver for it ([APPROVAL:waiver-$1]) can skip it";; esac
  mark "$f" "$1" - "(skipped: ${2:?reason})"; put last_mark "$(epoch)" "$f"; refresh "$f"; cmd_next
}
cmd_profile() { # switch the active run to lite or bugfix once the kind and size are known; only pending steps are skipped
  local p="${1:-}" f s skip dir; f=$(state_file); dir=$(dirname "$f")
  case "$p" in lite) skip=$LITE_SKIP;; bugfix) skip=$BUGFIX_SKIP;; *) die "usage: profile lite|bugfix";; esac
  # both skip gates, so neither is a free choice: only with the evidence on disk (lite: the planner sized it small;
  # bugfix: the fast triage and the planner both call it a bugfix), before any design, and never against a profile
  # the human chose
  if ! granted waiver-profile "$f"; then
    [ "$(get profile_set_by "$f")" = default ] || die "the human chose this profile (--profile); switching to $p needs [APPROVAL:waiver-profile]"
    case "$p" in
      lite) grep -Eqis '^size: *small' "$(latest "$dir/01-requirements")" || die "lite needs 'size: small' in the header of 01-requirements.md, or [APPROVAL:waiver-profile]";;
      bugfix) grep -Eqis '^kind: *bugfix' "$(latest "$dir/00-triage")" && grep -Eqis '^kind: *bugfix' "$(latest "$dir/01-requirements")" \
        || die "bugfix needs 'kind: bugfix' in the headers of both 00-triage.md and 01-requirements.md, or [APPROVAL:waiver-profile]";;
    esac
  fi
  grep -Eq '^- \[ \] architecture( |$)' "$f" || die "too late for $p: the architecture step is no longer pending"
  put profile "$p" "$f"
  for s in $skip; do grep -Eq "^- \[ \] $s( |\$)" "$f" && mark "$f" "$s" - "(skipped: $p profile)"; done
  refresh "$f"; cmd_next
}
# Temp files stay beside the run's files (mktemp "<dir>/.x.XXXXXX"), never in the system temp dir: a sandbox such as the
# plugin eval refuses that dir, and a verify that cannot start must not look like a failing suite.
# The hidden acceptance suite lives in .craftman/hidden/<run>/: the acceptance-writer writes the tests and a one-line
# `command` (with {dir} for the test directory) there, hide packs the tests into suite.tgz and removes the plaintext, and
# verify unpacks them into a temp folder for one run. A hook keeps the builders away from the folder.
# ponytail: packing deters a stray grep; it is not a security boundary (the orchestrator and the human see everything).
hidden_dir() { local f; f=$(state_file "${1:-}"); echo "$HID/$(get run "$f")"; }
cmd_hide() {
  local d n list; d=$(hidden_dir)
  [ -s "$d/command" ] || die "no $d/command: the acceptance-writer writes the tests and a one-line command (with {dir} for the test directory) there first"
  grep -q '{dir}' "$d/command" || die "$d/command must contain {dir}, the directory the tests run from"
  rm -rf "$d/.tmp"
  # a second hide (after a fix round) keeps the tests already packed; newer plaintext wins
  [ ! -f "$d/suite.tgz" ] || tar xzkf "$d/suite.tgz" -C "$d" 2>/dev/null || true
  list=$(mktemp "$d/.list.XXXXXX"); (cd "$d" && find . -type f ! -name command ! -name 'suite.tgz*' ! -name '.list.*' | sed 's#^\./##') > "$list"
  n=$(wc -l < "$list" | tr -d ' '); [ "$n" -gt 0 ] || { rm -f "$list"; die "no test files in $d"; }
  (cd "$d" && tar czf suite.tgz.new -T "$list" && mv suite.tgz.new suite.tgz) || { rm -f "$list"; die "could not pack $d"; }
  (cd "$d" && find . -mindepth 1 ! -name command ! -name suite.tgz -delete); rm -f "$list"
  echo "hidden: $n files packed into $d/suite.tgz, plaintext removed"
}
cmd_reveal() { # back to plaintext: for the acceptance-writer's fix round, and for QA once engineering passed
  local d; d=$(hidden_dir); [ -f "$d/suite.tgz" ] || die "no packed suite at $d/suite.tgz"
  tar xzf "$d/suite.tgz" -C "$d"; echo "$d"
}
cmd_verify() { # verify tests|hidden [--limit SECS]: run the suite here, not in an agent, and record the verdict the gates read
  local name="${1:-}" secs="${CRAFTMAN_VERIFY_LIMIT:-900}" f dir h tmp="" cmd shown out res n rc=0 t0 verdict note=""
  shift || true; [ "${1:-}" != --limit ] || { secs="${2:?seconds}"; shift 2; }
  f=$(state_file); dir=$(dirname "$f")
  case "$name" in
    tests) cmd=$(latest "$dir/04-context"); [ -z "$cmd" ] || cmd=$(sed -n 's/^test_command: *//p' "$cmd" | head -1); shown=$cmd
      [ -n "$cmd" ] || die "no 'test_command:' in the header of 04-context.md";;
    hidden) h=$(hidden_dir); [ -s "$h/command" ] || die "no hidden suite: the acceptance-writer writes $h/command and the tests first"
      shown=$(head -1 "$h/command"); cmd=$shown
      if [ -f "$h/suite.tgz" ]; then tmp="$h/.tmp"; rm -rf "$tmp"; mkdir -p "$tmp"; tar xzf "$h/suite.tgz" -C "$tmp"; cmd=${cmd//\{dir\}/$tmp}
      else cmd=${cmd//\{dir\}/$h}; fi;;
    *) die "usage: verify tests|hidden [--limit SECS]";;
  esac
  mkdir -p "$dir/verify"; n=0; for res in "$dir/verify/$name"*.md; do [ ! -f "$res" ] || n=$((n+1)); done
  res="$dir/verify/$name.md"; [ "$n" = 0 ] || res="$dir/verify/$name-$((n+1)).md"
  out=$(mktemp "$dir/verify/.out.XXXXXX"); t0=$(epoch)
  (cd "$ROOT" && limit "$secs" "$cmd") > "$out" 2>&1 || rc=$?
  [ -z "$tmp" ] || rm -rf "$tmp"
  verdict=PASS; [ "$rc" = 0 ] || verdict=FAIL; [ "$rc" != 124 ] || note=" (timed out after ${secs}s)"
  { printf -- '---\nagent: craftman-state\nstatus: done\nverdict: %s\ncommand: %s\nexit: %s\nseconds: %s\n---\n' "$verdict" "$shown" "$rc" "$(( $(epoch) - t0 ))"
    echo "## Output (last 80 lines)$note"; echo '```'; tail -n 80 "$out" | cut -c1-400; echo '```'; } > "$res"
  rm -f "$out"; refresh "$f"
  echo "verify $name: $verdict$note (exit $rc) -> $res"
  [ "$verdict" = PASS ]
}
# report.html beside state.md; best effort, never fails a state change
REPORT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/scripts/report.py"
refresh() { python3 "$REPORT" "$(dirname "$1")" "$FULL_STEPS" >/dev/null 2>&1 || true; }
cmd_report() {
  local show=0 f out; [ "${1:-}" = --open ] && { show=1; shift; }
  f=$(state_file "${1:-}"); out=$(python3 "$REPORT" "$(dirname "$f")" "$FULL_STEPS"); echo "$out"
  # --open: design diagrams do not render in a terminal, so show the report in the browser (best effort)
  if [ "$show" = 1 ] && [ "${CRAFTMAN_NOTIFY:-on}" != off ]; then { open "$out" || xdg-open "$out"; } >/dev/null 2>&1 || true; fi
}
cmd_services() { # what is up now that was not up when the run started
  local f before left; f=$(state_file "${1:-}"); before="$(dirname "$f")/services-before.txt"
  [ -f "$before" ] || { echo "services: no snapshot for this run"; return 0; }
  left=$(running 2>/dev/null | while read -r kind id rest; do
    [ "$kind" = docker ] || grep -qxF "$kind $id" "$before" || echo "  $kind $id ${rest:0:110}"; done) || true
  if [ -n "$left" ]; then echo "services: started during this run and still up (stop the ones the run started):"; echo "$left"
  else echo "services: nothing left running"; fi
  if grep -qx 'docker down' "$before" && dock ps -q >/dev/null; then echo "services: the Docker daemon was down when this run started; quit it if the run started it"; fi
}
cmd_set() {
  local f; f=$(state_file); local k="${1:?key}" v="${2-}"
  case "$k" in branch|packages_done) ;; *) die "settable keys: branch, packages_done";; esac
  put "$k" "$v" "$f"; echo "$k: $v"
}
cmd_escalate() {
  local r; r=$(run_id); echo "- $(now) ${1:?text}" >> "$MEM/$r/escalations.md"; cmd_notify "Escalation: $1"; echo "logged"
}
# Best-effort desktop notification, so a run that waits on the human is not left unnoticed. Never fails.
# CRAFTMAN_NOTIFY=off switches it off.
# A question for the human when the session has no question tool (Codex outside Plan mode): record it, print it, end
# the turn. The UserPromptSubmit hook matches the human's next message to one of the options and records the answer
# (an [APPROVAL:<category>] question answered "Approve" becomes a grant), like a question-tool answer.
cmd_ask() {
  local f dir; f=$(state_file); dir=$(dirname "$f")
  [ -n "${1:-}" ] && [ -n "${2:-}" ] || die 'usage: ask "<question>" "<option>|<option>..."'
  { echo "question: $(oneline "$1")"; echo "options: $(oneline "$2")"; echo "asked: $(now)"; } > "$dir/pending.md"
  cmd_notify "A question is waiting for your answer"
  printf '%s\nOptions: %s\nReply with one of the options.\n' "$1" "$2"
}
cmd_notify() {
  [ -f "$ACTIVE" ] && [ "${CRAFTMAN_NOTIFY:-on}" != off ] || return 0
  local m="${1:-AI-Craftman is waiting for you}"
  if command -v osascript >/dev/null 2>&1; then
    osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "AI-Craftman" sound name "Glass"' -e 'end run' "$m" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "AI-Craftman" "$m" >/dev/null 2>&1 || true
  fi
}
cmd_status() {
  local f; f=$(state_file "${1:-}")
  cat "$f"; echo; cmd_next "${1:-}"
  local r; r=$(get run "$f"); grep '^granted:' "$MEM/$r/approvals.md" 2>/dev/null || true
}
cmd_list() { [ -f "$MEM/index.md" ] && cat "$MEM/index.md" || echo "no runs yet"; [ -f "$ACTIVE" ] && echo "active: $(cat "$ACTIVE")"; }
cmd_resume() {
  local r="${1:?run-id}"; [ -f "$MEM/$r/state.md" ] || die "no run $r"
  # a finished run stays finished: resuming it would bring its old approvals back to life
  [ "$(get status "$MEM/$r/state.md")" = in_progress ] || die "run $r is $(get status "$MEM/$r/state.md"); start a new run instead"
  echo "$r" > "$ACTIVE"; put status in_progress "$MEM/$r/state.md"; put last_mark "$(epoch)" "$MEM/$r/state.md"; cmd_status "$r"
}
cmd_finish() {
  local f r; f=$(state_file); r=$(get run "$f")
  put status "${1:-complete}" "$f"; put finished "$(now)" "$f"
  local st; st=$(get started "$f"); st=$(date -u -j -f %Y-%m-%dT%H:%M:%SZ "$st" +%s 2>/dev/null || date -u -d "$st" +%s 2>/dev/null || echo "")
  [ -n "$st" ] && put duration "$(dur $(( $(epoch) - st )))" "$f"
  local tmp; tmp=$(mktemp "$MEM/index.md.XXXXXX")
  awk -v r="$r" -v s="${1:-complete}" 'index($0,"- "r" | ")==1 {sub(/\| in_progress \|/, "| "s" |")} {print}' "$MEM/index.md" > "$tmp" && mv "$tmp" "$MEM/index.md"
  refresh "$f"; cmd_services "$r" || true; rm -f "$ACTIVE"; echo "run $r ${1:-complete}"
}

case "${1:-}" in
  done|skip|set|profile|resume|finish) c=$1; shift; lock; "cmd_$c" "$@";;
  init|next|escalate|notify|status|list|report|services|verify|hide|reveal|ask) c=$1; shift; "cmd_$c" "$@";;
  *) cat <<EOF
usage: craftman-state <command>
  init <run-id> [--profile full|lite|bugfix] [--from STAGE] [--to STAGE] [--skip-deploy] [--lead] [--max-agent-calls N] [--requirement TEXT]
  next [run-id]              next pending step
  done <step> [note]         mark step done (active run); gates need their passing verdict or grant
  skip <step> <reason>       mark step skipped (gates need a human waiver)
  profile lite|bugfix        switch the active run to that profile (needs the planner's size / the agreed kind on disk)
  verify tests|hidden [--limit SECS]
                             run the test command (from 04-context.md) or the hidden suite here, record verify/<name>-<n>.md;
                             engineering is done only with both passing (CRAFTMAN_VERIFY_LIMIT, default 900s)
  hide | reveal              pack the hidden suite away before engineering / unpack it for a fix round or for QA
  set branch|packages_done <value>
  escalate <text>            log an escalation and notify the human
  ask <question> <opt|opt>   record a question for the human's next message (sessions without a question tool)
  notify [text]              desktop notification during an active run (CRAFTMAN_NOTIFY=off disables)
  status [run-id] | list | resume <run-id> | finish [complete|aborted]
  report [--open] [run-id]   write report.html (status, design diagrams, results), print its path, optionally open it
  services [run-id]          containers and project processes that are up now and were not when the run started
stages: $STAGES
EOF
  exit 1;;
esac
