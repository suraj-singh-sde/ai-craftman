{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/codex-session.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/deploy-guard.sh\"",
            "statusMessage": "AI-Craftman: deploy and control-file guard"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/file-guard.py\""
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/file-guard.py\"",
            "statusMessage": "AI-Craftman: file guard"
          }
        ]
      },
      {
        "matcher": "^(Agent|spawn_agent|send_input|resume_agent|SendMessage)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/agent-budget.sh\"",
            "statusMessage": "AI-Craftman: agent budget"
          }
        ]
      },
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/craftman-state\" notify \"A question is waiting for your answer\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/record-answers.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/record-answers.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/agents-active.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/agents-active.sh\""
          }
        ]
      }
    ]
  }
}
