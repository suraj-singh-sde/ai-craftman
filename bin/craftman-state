#!/usr/bin/env bash
# AI-Craftman run state. Plain text on purpose: readable by humans, greppable by hooks.
# Files: .craftman/active-run, .craftman/memory/index.md, .craftman/memory/<run>/{state,approvals,answers,escalations}.md
set -euo pipefail

ROOT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
MEM="$ROOT/.craftman/memory"
ACTIVE="$ROOT/.craftman/active-run"

STAGES="requirements context architecture engineering qa devops"
# step:stage:owner
FULL_STEPS="requirements:requirements:requirements-planner
clarifications:requirements:human-liaison
gov-requirements:requirements:governance
context:context:enterprise-context
legacy-analysis:context:legacy-analyst
context-memory:context:memory-keeper
architecture:architecture:architect
gov-architecture:architecture:governance
approve-architecture:architecture:human-oversight
design:architecture:architect
gov-design:architecture:governance
work-plan:architecture:workflow-coordinator
tracker-issues:architecture:orchestrator
git-branch:engineering:orchestrator
engineering:engineering:tdd-engineer,test-writer,code-writer,code-reviewer,code-optimizer
security-review:engineering:security-reviewer
qa:qa:qa-engineer
docs:qa:doc-writer
gov-release:qa:governance
pull-request:qa:orchestrator
delivery:devops:delivery-manager
deploy-decisions:devops:human-liaison
approve-deploy:devops:human-oversight
devops:devops:devops-engineer
operations:devops:operations-engineer
summary:finish:memory-keeper"
LITE_SKIP="gov-requirements approve-architecture design gov-design work-plan tracker-issues security-review"
# Gates are marked done only with their evidence on disk. step:result-file-prefix:passing-verdict
GATES="gov-requirements:03-gov-requirements:PASS
gov-architecture:07-gov-architecture:PASS
gov-design:08b-gov-design:PASS
security-review:10-security:PASS
qa:11-qa:READY
gov-release:13-gov-release:PASS"
PROTECTED="gov-requirements gov-architecture approve-architecture gov-design security-review qa gov-release"

die() { echo "craftman-state: $*" >&2; exit 1; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
epoch() { date -u +%s; }
dur() { local s=$1; [ "$s" -ge 3600 ] && printf '%dh%02dm' $((s/3600)) $((s%3600/60)) || printf '%dm%02ds' $((s/60)) $((s%60)); }
# elapsed since the previous done/skip (or init); steps run in order, so this is the step's wall-clock time
elapsed() { local last; last=$(get last_mark "$1"); [ -n "$last" ] && dur $(( $(epoch) - last )) || echo "?"; }
run_id() { [ -n "${1:-}" ] && echo "$1" || { [ -f "$ACTIVE" ] && cat "$ACTIVE"; } || die "no active run; pass a run id"; }
state_file() { local f="$MEM/$(run_id "${1:-}")/state.md"; [ -f "$f" ] || die "no state at $f"; echo "$f"; }
get() { sed -n "s/^$1: //p" "$2" | head -1; }
# replace "key: ..." line in place (portable: no sed -i; temp file beside target works inside the sandbox)
put() { local tmp; tmp=$(mktemp "$3.XXXXXX"); awk -v k="$1" -v v="$2" 'BEGIN{d=0} index($0,k": ")==1 && !d {print k": "v; d=1; next} {print}' "$3" > "$tmp" && mv "$tmp" "$3"; }
stage_index() { local i=0 s; for s in $STAGES; do [ "$s" = "$1" ] && { echo $i; return; }; i=$((i+1)); done; [ "$1" = finish ] && { echo 99; return; }; die "unknown stage: $1 (use: $STAGES)"; }
mark() { # mark <state> <step> <char> <note>
  local tmp; tmp=$(mktemp "$1.XXXXXX")
  awk -v s="$2" -v c="$3" -v n="$4" '$0 ~ "^- \\[.\\] "s"( |$)" {print "- ["c"] "s"  "n; f=1; next} {print} END{exit !f}' "$1" > "$tmp" || { rm -f "$tmp"; die "unknown step: $2"; }
  mv "$tmp" "$1"
}

# One writer at a time for state.md (the hooks update it too). A stale lock is taken over after ~5s.
LOCK="$ROOT/.craftman/.lock"
lock() { [ -d "$ROOT/.craftman" ] || return 0; local i=0; until mkdir "$LOCK" 2>/dev/null; do i=$((i+1)); [ "$i" -ge 50 ] && break; sleep 0.1; done; trap 'rmdir "$LOCK" 2>/dev/null' EXIT; }
# docker with a time limit: a sick daemon can hang for minutes, and a state change must never wait on it
dock() {
  command -v docker >/dev/null 2>&1 || return 1
  docker "$@" 2>/dev/null & local p=$!
  ( sleep 8; kill "$p" 2>/dev/null ) >/dev/null 2>&1 & local w=$! rc=0
  wait "$p" 2>/dev/null || rc=$?
  kill "$w" 2>/dev/null || true
  return "$rc"
}
# Containers, and processes that reference the project path (test runs, dev servers), as "kind id details" lines
running() {
  local pids
  dock ps --format 'container {{.ID}} {{.Image}} {{.Names}}' || echo "docker down"
  pids=$(pgrep -f "$ROOT/" 2>/dev/null | grep -vx "$$" | paste -sd, - || true)
  [ -z "$pids" ] || ps -o pid=,command= -p "$pids" 2>/dev/null | sed 's/^ */process /' || true
}
design_ok() { # design_ok <dir> <file-prefix> <diagrams>: the design has its mermaid diagrams and they will render
  grep -qs '^[[:space:]]*```mermaid' "$1/$2"*.md || die "$2.md needs its mermaid diagrams ($3): the human reads the design as diagrams"
  command -v python3 >/dev/null 2>&1 || return 0
  local problems; problems=$(python3 "$REPORT" --lint "$1/$2"*.md 2>/dev/null) \
    || die "$2.md has diagrams that will not render; have the architect fix them in place:"$'\n'"$problems"
}
latest() { # newest result of a gate: <prefix>.md is round 1, <prefix>-<n>.md is round n
  local f n best="" top=0
  for f in "$1"*.md; do
    [ -f "$f" ] || continue
    n=$(basename "$f" .md); n=${n##*-}; case "$n" in ''|*[!0-9]*) n=1;; esac
    [ "$n" -ge "$top" ] && { best=$f; top=$n; }
  done
  echo "$best"
}
granted() { grep -Eq "^granted: $1( |\$)" "$(dirname "$2")/approvals.md" 2>/dev/null; }   # granted <category> <state-file>
check_gate() { # check_gate <state-file> <step>: refuse unless the step's evidence exists
  local dir g prefix want; dir=$(dirname "$1")
  case "$2" in
    approve-architecture)
      granted architecture "$1" || grep -qs '^verdict: NO_APPROVAL_NEEDED' "$(latest "$dir/08-oversight-architecture")" \
        || die "approve-architecture needs the human's [APPROVAL:architecture] answer (or an oversight verdict NO_APPROVAL_NEEDED)";;
    approve-deploy) granted deploy "$1" || die "approve-deploy needs the human's [APPROVAL:deploy] answer";;
    # the human reads the design as diagrams (report, Design tab), so a design without them is not done
    architecture) design_ok "$dir" 06-hld "block diagram, main flow";;
    design) design_ok "$dir" 08a-lld "modules, data model, main flows";;
    *) g=$(echo "$GATES" | grep "^$2:") || return 0
       prefix=$(echo "$g" | cut -d: -f2); want=$(echo "$g" | cut -d: -f3)
       # the newest result decides (a later BLOCK overrides an earlier PASS); a waiver is for this gate only
       g=$(latest "$dir/$prefix"); [ -n "$g" ] || die "$2 has no result file ($prefix*.md); run the gate first"
       grep -qs "^verdict: $want" "$g" || granted "waiver-$2" "$1" \
         || die "$2 needs 'verdict: $want' in $(basename "$g"), or the human's waiver for this gate ([APPROVAL:waiver-$2])";;
  esac
}

cmd_init() {
  local run="${1:-}"; shift || true
  [ -n "$run" ] || die "usage: init <run-id> [--profile full|lite] [--from STAGE] [--to STAGE] [--skip-deploy] [--lead] [--max-agent-calls N] [--requirement TEXT]"
  local profile=full setby=default from=requirements to=devops skipdeploy=0 lead=off max=60 req=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) profile="$2"; setby=flag; shift 2;;
      --from) from="$2"; shift 2;;
      --to) to="$2"; shift 2;;
      --skip-deploy) skipdeploy=1; shift;;
      --lead) lead=on; shift;;
      --max-agent-calls) max="$2"; shift 2;;
      --requirement) req="$2"; shift 2;;
      *) die "unknown option $1";;
    esac
  done
  case "$profile" in full|lite) ;; *) die "profile must be full or lite";; esac
  case "$max" in ''|*[!0-9]*) max=60;; esac   # unsubstituted ${user_config...} falls back here
  local fi ti; fi=$(stage_index "$from"); ti=$(stage_index "$to")
  [ "$fi" -le "$ti" ] || die "--from is after --to"
  local dir="$MEM/$run"
  [ -f "$dir/state.md" ] && die "run $run already exists; use resume"
  mkdir -p "$dir"
  {
    echo "run: $run"
    echo "requirement: $req"
    echo "profile: $profile"
    echo "profile_set_by: $setby"
    echo "lead: $lead"
    echo "status: in_progress"
    echo "started: $(now)"
    echo "finished: "
    echo "duration: "
    echo "last_mark: $(epoch)"
    echo "agent_calls: 0"
    echo "max_agent_calls: $max"
    echo "branch: "
    echo "packages_done: "
    echo
    echo "## steps"
    local line step stage si
    while IFS= read -r line; do
      step=${line%%:*}; stage=$(echo "$line" | cut -d: -f2); si=$(stage_index "$stage")
      if [ "$si" -lt "$fi" ]; then echo "- [-] $step  (skipped: before --from $from)"
      elif [ "$si" -gt "$ti" ] && [ "$stage" != finish ]; then echo "- [-] $step  (skipped: after --to $to)"
      elif [ "$stage" = devops ] && [ "$skipdeploy" = 1 ]; then echo "- [-] $step  (skipped: --skip-deploy)"
      elif [ "$profile" = lite ] && echo " $LITE_SKIP " | grep -q " $step "; then echo "- [-] $step  (skipped: lite profile)"
      else echo "- [ ] $step"; fi
    done <<< "$FULL_STEPS"
  } > "$dir/state.md"
  for f in approvals answers escalations; do [ -f "$dir/$f.md" ] || echo "# $f ($run)" > "$dir/$f.md"; done
  mkdir -p "$MEM"; [ -f "$MEM/index.md" ] || echo "# AI-Craftman runs" > "$MEM/index.md"
  echo "- $run | in_progress | $(now) | ${req:0:100}" >> "$MEM/index.md"
  echo "$run" > "$ACTIVE"
  # A committed active-run would switch the guards on for everyone who pulls the branch.
  local p; for p in active-run .lock 'memory/*/report.html' 'memory/*/report-version.js'; do grep -qxF "$p" "$ROOT/.craftman/.gitignore" 2>/dev/null || echo "$p" >> "$ROOT/.craftman/.gitignore"; done
  # What is already running, so the run can stop exactly what it started and nothing else.
  running 2>/dev/null | cut -d' ' -f1,2 > "$dir/services-before.txt" || true
  refresh "$dir/state.md"
  echo "initialized $run ($profile, $from..$to$([ $skipdeploy = 1 ] && echo ', skip-deploy'))"
  cmd_next "$run"
}

cmd_next() {
  local f; f=$(state_file "${1:-}")
  local step; step=$(sed -n 's/^- \[ \] \([a-z-]*\).*/\1/p' "$f" | head -1)
  if [ -z "$step" ]; then echo "next: none (all steps done or skipped)"; return; fi
  local line; line=$(echo "$FULL_STEPS" | grep "^$step:")
  echo "next: $step  stage: $(echo "$line" | cut -d: -f2)  owner: $(echo "$line" | cut -d: -f3)"
}

cmd_done() { local f; f=$(state_file); check_gate "$f" "${1:?step}"; mark "$f" "$1" x "(done $(now), took $(elapsed "$f")) ${2:-}"; put last_mark "$(epoch)" "$f"; refresh "$f"; cmd_next; }
cmd_skip() {
  local f; f=$(state_file)
  case " $PROTECTED " in *" ${1:?step} "*) granted "waiver-$1" "$f" || die "$1 is a gate: only the profile, --from/--to or the human's waiver for it ([APPROVAL:waiver-$1]) can skip it";; esac
  mark "$f" "$1" - "(skipped: ${2:?reason})"; put last_mark "$(epoch)" "$f"; refresh "$f"; cmd_next
}
cmd_profile() { # switch the active run to lite once the size is known; only pending steps are skipped
  [ "${1:-}" = lite ] || die "usage: profile lite"
  local f s; f=$(state_file)
  # lite skips gates, so it is not a free choice: only for a change the planner sized small, before any design,
  # and never against a profile the human chose
  if ! granted waiver-profile "$f"; then
    [ "$(get profile_set_by "$f")" = default ] || die "the human chose this profile (--profile); switching to lite needs [APPROVAL:waiver-profile]"
    grep -Eqis '^size: *small' "$(dirname "$f")"/01-requirements*.md || die "lite needs 'size: small' in the header of 01-requirements.md, or [APPROVAL:waiver-profile]"
  fi
  grep -Eq '^- \[ \] architecture( |$)' "$f" || die "too late for lite: the architecture step is no longer pending"
  put profile lite "$f"
  for s in $LITE_SKIP; do grep -Eq "^- \[ \] $s( |\$)" "$f" && mark "$f" "$s" - "(skipped: lite profile)"; done
  refresh "$f"; cmd_next
}
# report.html beside state.md; best effort, never fails a state change
REPORT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/scripts/report.py"
refresh() { python3 "$REPORT" "$(dirname "$1")" "$FULL_STEPS" >/dev/null 2>&1 || true; }
cmd_report() {
  local show=0 f out; [ "${1:-}" = --open ] && { show=1; shift; }
  f=$(state_file "${1:-}"); out=$(python3 "$REPORT" "$(dirname "$f")" "$FULL_STEPS"); echo "$out"
  # --open: design diagrams do not render in a terminal, so show the report in the browser (best effort)
  if [ "$show" = 1 ] && [ "${CRAFTMAN_NOTIFY:-on}" != off ]; then { open "$out" || xdg-open "$out"; } >/dev/null 2>&1 || true; fi
}
cmd_services() { # what is up now that was not up when the run started
  local f before left; f=$(state_file "${1:-}"); before="$(dirname "$f")/services-before.txt"
  [ -f "$before" ] || { echo "services: no snapshot for this run"; return 0; }
  left=$(running 2>/dev/null | while read -r kind id rest; do
    [ "$kind" = docker ] || grep -qxF "$kind $id" "$before" || echo "  $kind $id ${rest:0:110}"; done) || true
  if [ -n "$left" ]; then echo "services: started during this run and still up (stop the ones the run started):"; echo "$left"
  else echo "services: nothing left running"; fi
  if grep -qx 'docker down' "$before" && dock ps -q >/dev/null; then echo "services: the Docker daemon was down when this run started; quit it if the run started it"; fi
}
cmd_set() {
  local f; f=$(state_file); local k="${1:?key}" v="${2-}"
  case "$k" in branch|packages_done) ;; *) die "settable keys: branch, packages_done";; esac
  put "$k" "$v" "$f"; echo "$k: $v"
}
cmd_escalate() {
  local r; r=$(run_id); echo "- $(now) ${1:?text}" >> "$MEM/$r/escalations.md"; cmd_notify "Escalation: $1"; echo "logged"
}
# Best-effort desktop notification, so a run that waits on the human is not left unnoticed. Never fails.
# CRAFTMAN_NOTIFY=off switches it off.
cmd_notify() {
  [ -f "$ACTIVE" ] && [ "${CRAFTMAN_NOTIFY:-on}" != off ] || return 0
  local m="${1:-AI-Craftman is waiting for you}"
  if command -v osascript >/dev/null 2>&1; then
    osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "AI-Craftman" sound name "Glass"' -e 'end run' "$m" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "AI-Craftman" "$m" >/dev/null 2>&1 || true
  fi
}
cmd_status() {
  local f; f=$(state_file "${1:-}")
  cat "$f"; echo; cmd_next "${1:-}"
  local r; r=$(get run "$f"); grep '^granted:' "$MEM/$r/approvals.md" 2>/dev/null || true
}
cmd_list() { [ -f "$MEM/index.md" ] && cat "$MEM/index.md" || echo "no runs yet"; [ -f "$ACTIVE" ] && echo "active: $(cat "$ACTIVE")"; }
cmd_resume() {
  local r="${1:?run-id}"; [ -f "$MEM/$r/state.md" ] || die "no run $r"
  echo "$r" > "$ACTIVE"; put status in_progress "$MEM/$r/state.md"; put last_mark "$(epoch)" "$MEM/$r/state.md"; cmd_status "$r"
}
cmd_finish() {
  local f r; f=$(state_file); r=$(get run "$f")
  put status "${1:-complete}" "$f"; put finished "$(now)" "$f"
  local st; st=$(get started "$f"); st=$(date -u -j -f %Y-%m-%dT%H:%M:%SZ "$st" +%s 2>/dev/null || date -u -d "$st" +%s 2>/dev/null || echo "")
  [ -n "$st" ] && put duration "$(dur $(( $(epoch) - st )))" "$f"
  local tmp; tmp=$(mktemp "$MEM/index.md.XXXXXX")
  awk -v r="$r" -v s="${1:-complete}" 'index($0,"- "r" | ")==1 {sub(/\| in_progress \|/, "| "s" |")} {print}' "$MEM/index.md" > "$tmp" && mv "$tmp" "$MEM/index.md"
  refresh "$f"; cmd_services "$r" || true; rm -f "$ACTIVE"; echo "run $r ${1:-complete}"
}

case "${1:-}" in
  done|skip|set|profile|resume|finish) c=$1; shift; lock; "cmd_$c" "$@";;
  init|next|escalate|notify|status|list|report|services) c=$1; shift; "cmd_$c" "$@";;
  *) cat <<EOF
usage: craftman-state <command>
  init <run-id> [--profile full|lite] [--from STAGE] [--to STAGE] [--skip-deploy] [--lead] [--max-agent-calls N] [--requirement TEXT]
  next [run-id]              next pending step
  done <step> [note]         mark step done (active run); gates need their passing verdict or grant
  skip <step> <reason>       mark step skipped (gates need a human waiver)
  profile lite               switch the active run to the lite profile
  set branch|packages_done <value>
  escalate <text>            log an escalation and notify the human
  notify [text]              desktop notification during an active run (CRAFTMAN_NOTIFY=off disables)
  status [run-id] | list | resume <run-id> | finish [complete|aborted]
  report [--open] [run-id]   write report.html (status, design diagrams, results), print its path, optionally open it
  services [run-id]          containers and project processes that are up now and were not when the run started
stages: $STAGES
EOF
  exit 1;;
esac
